# Copie este archivo como .env.local y complete los valores.
# .env.local está en .gitignore: no lo suba al repositorio.

# ---------------------------------------------------------------------------
# Consulta de estudiantes · Smart Campus
# ---------------------------------------------------------------------------

# Modo simulado. En "true" el endpoint /api/lookup no sale a la red y devuelve
# datos falsos deterministas derivados de la cédula, con 400 ms de latencia.
# Convención del simulador: las cédulas terminadas en 0 responden "no encontrado".
SMARTCAMPUS_MOCK=true

# URL COMPLETA del servicio, incluyendo host y ruta (POST, sin autenticación).
# Se le envía { documento, peunId } y responde { codigo, mensaje, valor }, con
# la persona dentro de `valor`. Documentación viva del servicio:
#   http://smartcampus.uniajc.edu.co:9000/<contexto>/swagger-ui.html
# El valor de abajo es el ambiente DEV; para producción cambie el contexto.
SMARTCAMPUS_URL=http://smartcampus.uniajc.edu.co:9000/rse_estudiantesaulasvirtuales-2.0-SNAPSHOT-DEV/api/v1/aulas-virtuales/estudiantes/consultar

# Identificador interno del semestre. Debe ser numérico.
# 1333 corresponde al semestre anterior y sirve para pruebas.
SMARTCAMPUS_PEUN_ID=1333

# ---------------------------------------------------------------------------
# Envío de registros · Power Automate
# ---------------------------------------------------------------------------

# Modo simulado. En "true" /api/submit/[formato] no sale a la red: escribe el
# registro en la consola del servidor y responde éxito tras 500 ms.
SUBMIT_MOCK=true

# URL del flujo de Power Automate que agrega la fila en Excel, una por formato.
# Son secretos: sólo se leen en el servidor y nunca llegan al navegador.
PA_URL_ENFERMERIA=
PA_URL_CONSULTA_MEDICA=
PA_URL_TAMIZAJE=
PA_URL_POLIZA=

# Flujo que envía el correo de aviso cuando una atención por accidente queda
# registrada con estado "En seguimiento". Se le envía { caso_id, estudiante,
# sede, diagnostico_presuntivo, url_caso, destinatarios } por POST;
# `destinatarios` es una cadena de correos separados por ";", armada en el
# servidor a partir de PA_URL_LISTAR_PERSONAS (ver lib/notificaciones.ts).
# Es un paso posterior al registro: si falla o falta, el caso igual queda
# guardado. Con SUBMIT_MOCK=true no se envía (no sale a la red).
PA_URL_NOTIFICAR_SEGUIMIENTO=

# Dominio público de la app, para armar el enlace al caso en ese correo
# (`{NEXT_PUBLIC_APP_URL}/poliza/seguimiento/{caso_id}`). Opcional: sin ella
# se usa el origin de la propia solicitud, que alcanza en desarrollo pero no
# siempre detrás de un proxy en producción.
# TODO(producción): fijarla, p. ej. https://bienestar.uniajc.edu.co
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Control de acceso · tabla Personas
# ---------------------------------------------------------------------------

# Clave para firmar la cookie de sesión (HMAC-SHA256). Genere una con:
#   openssl rand -base64 32
# Cambiarla cierra la sesión de todo el mundo (la firma deja de coincidir).
SESSION_SECRET=

# URL del flujo de Power Automate que lee la tabla Personas del Excel y
# devuelve la fila que corresponde al documento recibido (se le envía
# { documento } por POST). Igual que las PA_URL_* de arriba, es secreta: sólo
# se lee en el servidor.
PA_URL_LEER_PERSONAS=

# ---------------------------------------------------------------------------
# Panel de administración · Personas (módulo "admin")
# ---------------------------------------------------------------------------

# Flujo que lee TODAS las filas de la tabla Personas (se le envía {} por POST).
# Además del panel, la usa lib/notificaciones.ts para sacar los correos de
# quienes deben enterarse de un caso nuevo en seguimiento (columna `correo`).
PA_URL_LISTAR_PERSONAS=

# Flujo que agrega una fila en Personas (POST con la persona completa).
PA_URL_CREAR_PERSONA=

# Flujo que actualiza una fila de Personas por documento (POST con la persona
# completa; el documento identifica la fila a actualizar).
PA_URL_ACTUALIZAR_PERSONA=

# ---------------------------------------------------------------------------
# Seguimiento de casos · Póliza estudiantil (módulo "seguimiento")
# ---------------------------------------------------------------------------

# Flujo que lee todas las filas de AtencionesPoliza (se le envía {} por POST).
PA_URL_LEER_CASOS=

# Flujo que lee los seguimientos de un caso (se le envía { caso_id } por POST).
PA_URL_LEER_SEGUIMIENTOS=

# Flujo que agrega una fila en Seguimientos (POST con el seguimiento completo).
PA_URL_SEGUIMIENTO=

# Flujo que actualiza estado = "Cerrado" en AtencionesPoliza (se le envía
# { caso_id } por POST).
PA_URL_CERRAR_CASO=

# Flujo que sube un soporte del caso (incapacidad, fórmula, historia clínica,
# radiografía…) a OneDrive, creando la carpeta del caso si no existe. Se le
# envía { caso_id, documento, nombres, apellidos, periodo, nombre_archivo,
# contenido_base64 } por POST; el archivo ya llega comprimido y en base64
# desde el navegador (ver lib/archivos.ts).
PA_URL_SUBIR_SOPORTE=

# Flujo que lee los soportes ya subidos de un caso (se le envía { caso_id }
# por POST). Cada fila trae caso_id, nombre_archivo, tipo, url_web,
# subido_por y fecha; la respuesta puede venir como arreglo directo o
# envuelta en { value: [...] } (se parsea igual que PA_URL_LEER_CASOS).
PA_URL_LEER_SOPORTES=

# ---------------------------------------------------------------------------
# Asistente de redacción · Anthropic (botón "Mejorar redacción")
# ---------------------------------------------------------------------------

# Modo simulado. En "true" /api/mejorar-texto no sale a la red: ordena
# espacios y capitaliza la primera letra del texto recibido, con 500 ms de
# latencia. Sirve para probar el flujo sin gastar cupo de la API.
MEJORAR_TEXTO_MOCK=true

# Clave de la API de Anthropic. Sólo se lee en el servidor, en
# lib/asistenteRedaccion.ts; NUNCA lleva el prefijo NEXT_PUBLIC_ y nunca llega
# al navegador. El campo que se le envía es únicamente el texto del campo
# (sin cédula, nombre ni caso_id — ver AGENTS.md). Se obtiene en
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
