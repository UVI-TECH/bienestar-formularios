# Copie este archivo como .env.local y complete los valores.
# .env.local está en .gitignore: no lo suba al repositorio.

# ---------------------------------------------------------------------------
# Consulta de estudiantes · Smart Campus
# ---------------------------------------------------------------------------

# Modo simulado. En "true" el endpoint /api/lookup no sale a la red y devuelve
# datos falsos deterministas derivados de la cédula, con 400 ms de latencia.
# Convención del simulador: las cédulas terminadas en 0 responden "no encontrado".
SMARTCAMPUS_MOCK=true

# URL COMPLETA del servicio, incluyendo host y ruta. La ruta es
# /api/v1/aulas-virtuales/estudiantes/consultar (POST, sin autenticación).
# Se le envía { documento, peunId } y devuelve { nombre, apellido, programa, … }.
# PENDIENTE: falta el host; solicitarlo a la oficina Smart Campus.
SMARTCAMPUS_URL=

# Identificador interno del semestre. Debe ser numérico.
# 1333 corresponde al semestre anterior y sirve para pruebas.
SMARTCAMPUS_PEUN_ID=1333

# ---------------------------------------------------------------------------
# Envío de registros · Power Automate
# ---------------------------------------------------------------------------

# Modo simulado. En "true" /api/submit/[formato] no sale a la red: escribe el
# registro en la consola del servidor y responde éxito tras 500 ms.
SUBMIT_MOCK=true

# URL del flujo de Power Automate que agrega la fila en Excel, una por formato.
# Son secretos: sólo se leen en el servidor y nunca llegan al navegador.
PA_URL_ENFERMERIA=
PA_URL_CONSULTA_MEDICA=
PA_URL_TAMIZAJE=
PA_URL_POLIZA=
